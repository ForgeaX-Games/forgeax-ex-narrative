{
  "name": "@forgeax-extension/narrative",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ForgeaX-Games/forgeax-ex-narrative.git"
  },
  "version": "0.2.0",
  "description": "AI-driven narrative content generation pipeline for game development",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "forgeax-narrative": "dist/bin/narrative.js"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "viz/dist",
    "server",
    "schemas",
    "forgeax-extension.json",
    "marketplace-card.json",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "npm run build:backend && npm run build:viz",
    "build:backend": "node scripts/clean-dist.mjs && tsx scripts/gen-seats.ts && tsc && tsx scripts/copy-runtime-assets.ts",
    "build:viz": "npm --prefix viz ci && npm --prefix viz run build",
    "gen:seats": "tsx scripts/gen-seats.ts",
    "gen:catalog": "node scripts/gen-tool-catalog.mjs",
    "build:extension": "bun scripts/build-extension.mjs",
    "build:skills": "tsx scripts/build-skills.ts",
    "dev": "tsx --env-file=.env src/cli.ts",
    "start": "node --env-file-if-exists=.env dist/api/server.js",
    "lint": "tsc --noEmit && tsx scripts/lint-wording.ts",
    "lint:wording": "tsx scripts/lint-wording.ts",
    "lint:strategy": "tsx scripts/lint-strategy.ts",
    "test": "vitest run --exclude scripts/publish-workflow-contract.test.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@xenova/transformers": "^2.17.2",
    "express": "^5.1.0",
    "mammoth": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
