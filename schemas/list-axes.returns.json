{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Narrative type axis vocabulary: code / name / summary / traits."
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Narrative theme axis vocabulary."
    },
    "structures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Narrative structure cards. Shown for reference only: the structure is derived from type + theme, not chosen."
    }
  }
}
